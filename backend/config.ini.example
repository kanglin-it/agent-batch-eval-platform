# 复制为 config.ini 后填写实际值 (config.ini 已被 gitignore, 不会提交)。
# 密码含特殊字符(@ # $ ! ) 等)直接写, 无需任何转义/URL 编码。

[database]
# 登录用库(运营平台用户表 t_operation_user 所在库) —— PostgreSQL, 本地直连服务器库。
# 若运营平台库与用例库不是同一个, 这里填运营平台库。
host = your-pg-host
port = 5432
user = zhiexa_saas
password = your-password
dbname = saas
# 登录校验用的用户表; 运营平台 User 继承 AbstractUser, 密码是 Django 标准哈希, 按 username 登录。
user_table = t_operation_user

[case_database]
# 用例库: 直接查 SaaS 原始任务表(与 scripts/export_history_seed_sql.py 同源)。
# 留空则复用 [database] 的连接。
host =
port =
user =
password =
dbname =
schema = public
# 以下两表仅兼容旧导出流程, 列表/回填已不再读取
qa_table = t_history_qa_dataset
review_table = t_history_review_dataset

[jwt]
secret = change-me-to-a-long-random-string
algorithm = HS256
# 登录态默认时长(秒); 运行时可被 系统设置 覆盖。30 天 = 2592000
login_ttl_seconds = 2592000

[app]
runtime_config_path = runtime_config.json
cors_origins = http://localhost:5173

[zhiexa]
login_url = https://www.zhiexa.com/zhiexa/saas/api/v1/auth/password/login
skill_base = https://skill.zhiexa.com
phone = 15067062596
password = your-zhiexa-password
channel_type = PC
jwt_ttl_seconds = 518400
chat_timeout = 300
