# ---- Database (point to the SAME DB as the Django ops backend) ----
# MySQL example:
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/ops_backend
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/ops_backend

# Django's user table name. Default is `auth_user`.
# If the ops backend uses a custom AUTH_USER_MODEL, change it (e.g. users_user).
USER_TABLE=auth_user

# ---- Case-data database (PostgreSQL 'saas') — read by 用例管理页 ----
CASE_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/saas
CASE_QA_TABLE=t_history_qa_dataset
CASE_REVIEW_TABLE=t_history_review_dataset

# ---- JWT (this platform's own token — NOT related to Django SECRET_KEY) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Default login-session lifetime in seconds. Default 2592000 = 30 days.
# This is only the DEFAULT — a superuser can change it at runtime via
# PUT /api/settings/login-ttl (persisted to the JSON config file below, no DB table).
LOGIN_TTL_SECONDS=2592000
# Path to the runtime-editable JSON config file holding admin overrides.
RUNTIME_CONFIG_PATH=runtime_config.json

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- Local dev only ----
# When true, /api/auth/login accepts ANY username/password (superuser token) without
# a user DB — for local UI preview. NEVER enable in production.
DEV_LOGIN_ENABLED=false

# ---- External services (evaluation) ----
COZE_API_BASE=https://api.coze.cn
COZE_API_TOKEN=
AGENT_API_BASE=

# ---- Zhiexa Agent (sandbox conversation) — the Agent that reruns cases ----
ZHIEXA_LOGIN_URL=https://www.zhiexa.com/zhiexa/saas/api/v1/auth/password/login
ZHIEXA_SKILL_BASE=https://skill.zhiexa.com
ZHIEXA_PHONE=15067062596
# Pre-encrypted password. Prefer injecting from a secret store over committing it.
ZHIEXA_PASSWORD=
ZHIEXA_CHANNEL_TYPE=PC
